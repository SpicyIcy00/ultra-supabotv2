# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bidashboard

# George's read-only role and its connection gate. The Supabase SESSION-mode
# pooler (port 5432) caps george_ro at 15 backends; every tool call opens one
# connection, and chat turns, pins and workflows fan calls out together. The
# gate is per PROCESS and shared by all of them. 8 leaves room for a second
# process this one cannot see. See tools/_common.py.
GEORGE_DATABASE_URL=postgresql://george_ro.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
GEORGE_MAX_CONNECTIONS=8
GEORGE_CONNECTION_WAIT_S=20
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Environment
ENVIRONMENT=development

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=BI Dashboard API
VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
