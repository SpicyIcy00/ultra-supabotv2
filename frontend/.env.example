# Browser clients use same-origin /api/v1. No browser model key is needed.
# Server-side Vercel middleware only; configure in the Preview environment.
STAGING_API_BACKEND_ORIGIN=
# Optional explicit staging designation (also for a dedicated project's main).
API_DEPLOYMENT_ENV=staging
# Optional production override; previews reject this origin as a target too.
API_BACKEND_ORIGIN=
# VERCEL_ENV and VERCEL_GIT_COMMIT_REF come from Vercel system variables.
# Legacy Sheets is unrelated to George. Leave absent in staging.
VITE_GOOGLE_SHEETS_URL=
